# 飞书配置示例文件
#
# 使用方式（二选一）：
#
# 方式一：环境变量（推荐，用于云端/容器环境）
#   直接设置以下环境变量即可，无需创建此文件。
#   定时任务会优先从系统环境变量读取。
#
# 方式二：本地配置文件（用于本地开发/调试）
#   1. 复制本文件为 feishu_config.env
#      cp config/feishu_config.env.example config/feishu_config.env
#   2. 将下方的占位值替换为你自己的实际配置
#   3. feishu_config.env 已在 .gitignore 中，不会被提交到仓库

# 飞书自建应用凭证（必填）
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 知识库配置
FEISHU_SPACE_ID=your_space_id_here
FEISHU_HOME_NODE_TOKEN=your_home_node_token_here
FEISHU_HISTORY_NODE_TOKEN=your_history_node_token_here

# 用户配置（用于接收消息通知的 open_id）
# 注意：open_id 是用户在**当前应用**下的身份标识，不同应用 open_id 不同
FEISHU_USER_OPEN_ID=ou_xxxxxxxxxx

# 知识库首页链接
FEISHU_HOME_URL=https://your-feishu-domain/wiki/your_home_node_token

# GitHub Token（用于git推送，云端环境通过环境变量传入）
GITHUB_TOKEN=your_github_token_here
