# 飞书配置示例文件
# 使用方法：
# 1. 复制本文件为 feishu_config.env
#    cp config/feishu_config.env.example config/feishu_config.env
# 2. 将下方的占位值替换为你自己的实际配置
# 3. feishu_config.env 已在 .gitignore 中，不会被提交到仓库

# 知识库配置
FEISHU_SPACE_ID=your_space_id_here
FEISHU_HOME_NODE_TOKEN=your_home_node_token_here
FEISHU_HISTORY_NODE_TOKEN=your_history_node_token_here

# 用户配置
FEISHU_USER_OPEN_ID=your_open_id_here

# 知识库链接
FEISHU_HOME_URL=https://your-feishu-domain/wiki/your_home_node_token
